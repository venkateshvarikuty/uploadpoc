#
# This file contains the filter ACL, and can be customized.
#
# By default, it includes the default filter ACL.
#

$include "./default_filters.any"

# Allow components JSON model
/0101 { /type "allow" /extension "json" /selectors "model" /path "/content/*" }

# Allow manifest.webmanifest files located in the content
/0102 { /type "allow" /extension "webmanifest" /path "/content/*/manifest" }

# Allow Upload POC custom servlets
/0200 { /type "allow" /method "GET" /url "/bin/assetShareLink" }
/0201 { /type "allow" /method "POST" /url "/bin/upload" }
/0202 { /type "allow" /method "POST" /url "/bin/cartology/sharelink" }

# Allow Cartology Naming Rules API
/0210 { /type "allow" /method "GET"    /url "/api/cartology/naming-rules" }
/0211 { /type "allow" /method "PUT"    /url "/api/cartology/naming-rules" }
/0212 { /type "allow" /method "DELETE" /url "/api/cartology/naming-rules" }
